{
  "colors": {
    "primary": "#0097FF",
    "secondary": "#3DC47E",
    "accent": "#EAF8F2",
    "background": "#0b1c3f",
    "dark_text": "#2E2E2E"
  },
  "font": {
    "heading_family": "Satoshi",
    "body_family": "General Sans",
    "local_path": "fonts/InterVariable.ttf",
    "heading_local_path": "fonts/InterVariable.ttf",
    "body_local_path": "fonts/InterVariable.ttf",
    "google_fonts_url": "https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&f[]=general-sans@700,500,300,600,400&display=swap"
  },
  "logo_url": "logo/mint green-tranparent.svg",
  "logo_on_dark": "logo/mint green-tranparent.svg",
  "logo_on_light": "logo/blue-transparent.svg",
  "button_style": "pill_filled",
  "voice": {
    "avoid_phrases": [
      "100%",
      "guaranteed",
      "revolutionary",
      "game-changing",
      "unprecedented"
    ],
    "require": [
      "at least one measurable benefit",
      "caption ends with an engaging question"
    ]
  }
}
