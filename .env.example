# Node API
PORT=3000
DATABASE_URL=postgresql://user:pass@postgres:5432/linkedin_automation
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
WEBHOOK_SECRET=whsec_your_webhook_secret_here
OPENAI_API_KEY=sk-proj-xxx
FRONTEND_URL=http://localhost:3001

# Single-designer login (set ADMIN_PASSWORD_HASH in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=8

# LinkedIn Developer app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/v1/linkedin/oauth/callback
LINKEDIN_API_VERSION=202606
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Python Worker
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_URL=http://chroma:8000
POST_FEEDBACK_COLLECTION=post_review_feedback
MAX_WORKERS=2
QUEUE_NAME=document-processing
